<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>What needs my attention? – Prototype</title>
<style>
:root{--bg:#f1f3f6;--card:#fff;--tx:#14181f;--mut:#667085;--line:#e3e7ee;--acc:#0a7d4f;--accbg:#e6f5ee;--warn:#b54708;--warnbg:#fff3e0;--info:#175cd3;--infobg:#e8f0fe;--dang:#b42318;--dangbg:#fdecea;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);color-scheme:light}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0e1116;--card:#1a1f27;--tx:#eef1f5;--mut:#9aa4b2;--line:#2b323d;--acc:#4cc38a;--accbg:#12301f;--warn:#f5a04a;--warnbg:#3a2a12;--info:#7aa7ff;--infobg:#142544;--dang:#ff8a80;--dangbg:#3b1815;color-scheme:dark}}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--tx);font:15px/1.45 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;display:flex;flex-wrap:wrap;gap:24px;justify-content:center;align-items:flex-start;padding:20px 12px}
.side{width:260px;max-width:100%}
.side h1{font-size:18px;margin:0 0 6px}
.side p{color:var(--mut);font-size:13px;margin:0 0 12px}
.steps{display:flex;flex-direction:column;gap:6px}
.steps button{all:unset;cursor:pointer;padding:8px 10px;border:1px solid var(--line);border-radius:10px;background:var(--card);font-size:13px}
.steps button.on{border-color:var(--acc);background:var(--accbg);font-weight:600}
.phone{width:360px;max-width:100%;height:700px;background:var(--card);border:1px solid var(--line);border-radius:30px;overflow:hidden;position:relative;box-shadow:0 8px 30px rgba(0,0,0,.12);display:flex;flex-direction:column}
.top{padding:14px 18px 8px;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--line);font-weight:600}
.top .gear{cursor:pointer;color:var(--mut);background:none;border:0;font-size:18px}
.scr{display:none;flex:1;overflow-y:auto;padding:16px 18px 20px}
.scr.on{display:block}
h2{font-size:21px;margin:4px 0 4px}
.sub{color:var(--mut);margin:0 0 14px}
.card{border:1px solid var(--line);border-radius:14px;padding:12px 14px;margin:0 0 10px;background:var(--card)}
.card.click{cursor:pointer}
.tag{display:inline-block;font-size:11px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;padding:2px 8px;border-radius:99px;margin-bottom:6px}
.t-act{background:var(--warnbg);color:var(--warn)}.t-know{background:var(--accbg);color:var(--acc)}.t-later{background:var(--infobg);color:var(--info)}
.card h3{font-size:15px;margin:0 0 2px}
.card p{margin:0;color:var(--mut);font-size:13.5px}
.btn{display:block;width:100%;padding:13px;border-radius:12px;border:1px solid var(--line);background:var(--card);color:var(--tx);font:inherit;font-weight:600;cursor:pointer;margin:0 0 8px;text-align:center}
.btn.p{background:var(--acc);border-color:var(--acc);color:#fff}
.btn.s{font-weight:500;color:var(--mut);padding:10px}
.row{display:flex;gap:8px}.row .btn{margin:0}
.big{width:64px;height:64px;border-radius:50%;background:var(--accbg);color:var(--acc);display:flex;align-items:center;justify-content:center;font-size:30px;margin:10px auto}
.center{text-align:center}
.kv{display:flex;gap:10px;padding:8px 0;border-top:1px solid var(--line);font-size:13.5px}
.kv:first-of-type{border-top:0}.kv b{min-width:84px;color:var(--mut);font-weight:600}
.tl{border-left:2px solid var(--line);margin:10px 0 14px 8px;padding-left:16px}
.tl div{position:relative;margin-bottom:14px;font-size:13.5px}
.tl div:before{content:"";position:absolute;left:-23px;top:4px;width:10px;height:10px;border-radius:50%;background:var(--acc)}
.tl div.off:before{background:var(--line)}
.tabs{display:flex;gap:6px;margin-bottom:12px}
.tabs button{flex:1;padding:9px;border-radius:10px;border:1px solid var(--line);background:var(--card);color:var(--tx);font:inherit;font-size:13px;cursor:pointer}
.tabs button.on{border-color:var(--acc);background:var(--accbg);font-weight:600}
.note{font-size:12px;color:var(--mut);margin-top:10px}
.alert{background:var(--dangbg);color:var(--dang);border-radius:12px;padding:10px 12px;font-size:13.5px;margin-bottom:10px}
.back{background:none;border:0;color:var(--mut);font:inherit;cursor:pointer;padding:0 0 8px}
.sheet{position:absolute;inset:0;background:rgba(0,0,0,.45);display:none;align-items:flex-end}
.sheet.on{display:flex}
.sheet>div{background:var(--card);width:100%;border-radius:22px 22px 0 0;padding:18px}
.opt{display:flex;justify-content:space-between;align-items:center;padding:12px 0;border-top:1px solid var(--line)}
.opt input{width:20px;height:20px;accent-color:var(--acc)}
.opt:first-of-type{border-top:0}
.det{display:none;margin-top:8px;font-size:13px;color:var(--tx)}
.card.open .det{display:block}
</style>
</head>
<body>
<div class="side">
  <h1>What needs my attention?</h1>
  <p>Clickable prototype, 6 screens. Persona: Daniyar, 41, long-term investor. All data is fictional. Today: Nov 14, 2026.</p>
  <div class="steps" id="steps"></div>
  <p class="note">Tap through the phone, or jump between screens here.</p>
</div>

<div class="phone">
  <div class="top"><span>Freedom Broker</span><button class="gear" id="gear" aria-label="Notification settings">⚙</button></div>

  <!-- 1 -->
  <div class="scr on" data-s="1">
    <p class="sub" style="margin-bottom:2px">Welcome back, Daniyar</p>
    <h2>Last 7 days: 1 task, 2 updates</h2>
    <p class="sub">Only one item needs you. The rest is for your information.</p>
    <div class="card click" data-go="3" style="border-color:var(--warn)">
      <span class="tag t-act">Action needed</span>
      <h3>Confirm your details by Nov 21</h3>
      <p>Takes about 1 minute · 7 days left</p>
    </div>
    <div class="card"><span class="tag t-know">Good to know</span><h3>Bond payout received: +12,400 ₸</h3><p>Already in your account. Nothing to do.</p></div>
    <div class="card"><span class="tag t-later">Can wait</span><h3>1 company news item</h3><p>Price −2%. Does not change your long-term plan.</p></div>
    <button class="btn p" data-go="2" style="margin-top:12px">See details</button>
    <button class="btn s" data-go="3">Go straight to the task</button>
  </div>

  <!-- 2 -->
  <div class="scr" data-s="2">
    <button class="back" data-go="1">← Back</button>
    <h2>Sorted for you</h2>
    <p class="sub">Three groups, so you know what to do first.</p>
    <p class="tag t-act">Action needed · 1</p>
    <div class="card click" data-go="3" style="border-color:var(--warn)"><h3>Confirm your details</h3><p>Deadline: Nov 21. Tap to open.</p></div>
    <p class="tag t-know">Good to know · 1</p>
    <div class="card click" data-toggle><h3>Payout +12,400 ₸ from bond “KZ-2031”</h3><p>Credited Nov 12. No action required.</p><div class="det">Your payout has been added to your cash balance. You can reinvest it whenever you like.</div></div>
    <p class="tag t-later">Can wait · 1</p>
    <div class="card click" data-toggle><h3>Company news: Alpha Corp (in your portfolio)</h3><p>Price −2% this week. Your strategy does not change.</p><div class="det">Alpha Corp reported lower quarterly revenue. It is 4% of your portfolio. We will include it in your Sunday digest.</div></div>
    <button class="btn p" data-go="3">Open the task</button>
  </div>

  <!-- 3 -->
  <div class="scr" data-s="3">
    <button class="back" data-go="2">← Back</button>
    <span class="tag t-act">Action needed</span>
    <h2>Confirm your details</h2>
    <p class="sub">7 days left · due Nov 21</p>
    <div class="card" style="padding:4px 14px">
      <div class="kv"><b>What</b><span>Check 3 fields: phone, address, tax residency</span></div>
      <div class="kv"><b>Why</b><span>Brokers must keep client details up to date.</span></div>
      <div class="kv"><b>If you skip</b><span>New purchases may be paused. Your money and holdings stay untouched. <i>(assumption)</i></span></div>
    </div>
    <button class="btn p" data-go="4">Confirm now</button>
    <div class="row"><button class="btn" data-remind="tomorrow">Remind me tomorrow</button><button class="btn" data-remind="2days">2 days before</button></div>
    <button class="btn s" data-go="6" data-tab="why" style="margin-top:8px">Why is this needed?</button>
    <button class="btn s" data-go="6" data-tab="fake" style="color:var(--dang)">This doesn’t look right</button>
    <p class="note">Document checking is out of scope for this prototype.</p>
  </div>

  <!-- 4 -->
  <div class="scr center" data-s="4">
    <div class="big">✓</div>
    <h2>Details confirmed</h2>
    <p class="sub">Thank you. You’re all set until next year.</p>
    <div class="card" style="text-align:left"><span class="tag t-know">Updated</span><h3>Action needed: 0</h3><p>Your home screen now shows nothing urgent.</p></div>
    <button class="btn p" data-go="1" data-done>Back to home</button>
    <p class="note">Result state: the task disappears from “Action needed”.</p>
  </div>

  <!-- 5 -->
  <div class="scr" data-s="5">
    <div class="big" style="background:var(--warnbg);color:var(--warn)">⏰</div>
    <h2 class="center" id="p5t">We’ll remind you</h2>
    <p class="sub center">Not done yet. Here is what happens next.</p>
    <div class="tl" id="tl"></div>
    <div class="alert" style="background:var(--warnbg);color:var(--warn)">If there is no answer by Nov 21, new purchases may be paused until you confirm. Your holdings are not affected.</div>
    <button class="btn p" data-go="4">Confirm now instead</button>
    <button class="btn" onclick="this.textContent='Added to your calendar ✓'">Add deadline to calendar</button>
    <button class="btn s" data-go="1">Back to home</button>
  </div>

  <!-- 6 -->
  <div class="scr" data-s="6">
    <button class="back" data-go="3">← Back to the task</button>
    <div class="tabs"><button data-tab="why">Why is this needed?</button><button data-tab="fake">Looks suspicious</button></div>
    <div id="tab-why">
      <h2>In plain words</h2>
      <p>Rules require us to keep your contact and tax details current. If they are outdated, we may not be able to reach you or report correctly.</p>
      <div class="card"><b>It takes 1 minute.</b><p>You only check three fields, you don’t upload anything.</p></div>
      <button class="btn p" data-go="3">Got it, back to the task</button>
    </div>
    <div id="tab-fake" style="display:none">
      <h2>Let’s make sure it’s real</h2>
      <div class="alert">We will never ask for your password, SMS code or card PIN in this request.</div>
      <div class="card"><b>Check:</b><p>1) Is it shown inside the app, on the “Action needed” list? 2) Does it only ask to confirm 3 fields? If yes, it is genuine.</p></div>
      <div class="card"><b>Still unsure?</b><p>Don’t tap links in SMS or messengers. Contact support from the app.</p></div>
      <button class="btn p" onclick="this.textContent='Support chat opened (demo) ✓'">Contact support</button>
      <button class="btn" data-go="3">Back to the task</button>
    </div>
  </div>

  <!-- settings -->
  <div class="sheet" id="sheet"><div>
    <h2 style="margin-top:0">What should we tell you right away?</h2>
    <p class="sub">Everything else goes into one weekly digest.</p>
    <label class="opt"><span><b>Actions and deadlines</b><br><small style="color:var(--mut)">Always on</small></span><input type="checkbox" checked disabled></label>
    <label class="opt"><span><b>Payouts</b></span><input type="checkbox"></label>
    <label class="opt"><span><b>News on my portfolio</b></span><input type="checkbox"></label>
    <button class="btn p" id="close" style="margin-top:12px">Save</button>
  </div></div>
</div>

<script>
var names=["1 · Return after a week","2 · Three groups","3 · The request","4 · Result: done","5 · Postponed","6 · Doubt / mistrust"];
var st=document.getElementById("steps");
names.forEach(function(n,i){var b=document.createElement("button");b.textContent=n;b.onclick=function(){go(i+1)};st.appendChild(b)});
function go(n,tab){
  document.querySelectorAll(".scr").forEach(function(s){s.classList.toggle("on",s.dataset.s==n)});
  st.querySelectorAll("button").forEach(function(b,i){b.classList.toggle("on",i+1==n)});
  if(n==6)setTab(tab||"why");
  document.querySelector(".scr.on").scrollTop=0;
}
function setTab(t){
  document.getElementById("tab-why").style.display=t=="why"?"block":"none";
  document.getElementById("tab-fake").style.display=t=="fake"?"block":"none";
  document.querySelectorAll(".tabs button").forEach(function(b){b.classList.toggle("on",b.dataset.tab==t)});
}
document.querySelectorAll("[data-go]").forEach(function(e){e.addEventListener("click",function(){go(+e.dataset.go,e.dataset.tab)})});
document.querySelectorAll(".tabs button").forEach(function(b){b.addEventListener("click",function(){setTab(b.dataset.tab)})});
document.querySelectorAll("[data-toggle]").forEach(function(c){c.addEventListener("click",function(){c.classList.toggle("open")})});
document.querySelectorAll("[data-remind]").forEach(function(b){b.addEventListener("click",function(){
  var two=b.dataset.remind=="2days";
  document.getElementById("p5t").textContent=two?"Reminder set: 2 days before":"Reminder set: tomorrow";
  document.getElementById("tl").innerHTML=
    "<div><b>Nov 14 (today)</b><br>You postponed. Task stays in “Action needed”.</div>"+
    (two?"":"<div><b>Nov 15, 10:00</b><br>Push reminder: “1 minute to confirm your details”.</div>")+
    "<div><b>Nov 19, 10:00</b><br>Push reminder: “2 days left”.</div>"+
    "<div><b>Nov 21, 09:00</b><br>Final reminder (SMS if you allow it).</div>"+
    "<div class=\"off\"><b>Nov 22</b><br>Deadline passed: purchases may pause.</div>";
  go(5);
})});
document.getElementById("gear").onclick=function(){document.getElementById("sheet").classList.add("on")};
document.getElementById("close").onclick=function(){document.getElementById("sheet").classList.remove("on")};
go(1);
</script>
</body>
</html>
